; Exportaciones de tiresiasControllerClient.dll.
; Las nvdaController_* son alias compatibles con el "NVDA Controller Client".
LIBRARY tiresiasControllerClient
EXPORTS
	tiresiasController_testIfRunning
	tiresiasController_speakText
	tiresiasController_cancelSpeech
	tiresiasController_brailleMessage
	tiresiasController_getProcessId
	tiresiasController_speakSsml
	tiresiasController_setOnSsmlMarkReachedCallback
	tiresiasController_isSpeaking
	tiresiasController_getApiVersion
	tiresiasController_speakTextEx
	tiresiasController_pauseSpeech
	nvdaController_testIfRunning=tiresiasController_testIfRunning
	nvdaController_speakText=tiresiasController_speakText
	nvdaController_cancelSpeech=tiresiasController_cancelSpeech
	nvdaController_brailleMessage=tiresiasController_brailleMessage
	nvdaController_getProcessId=tiresiasController_getProcessId
	nvdaController_speakSsml=tiresiasController_speakSsml
	nvdaController_setOnSsmlMarkReachedCallback=tiresiasController_setOnSsmlMarkReachedCallback
	nvdaController_isSpeaking=tiresiasController_isSpeaking
