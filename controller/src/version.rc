// Información de versión de las bibliotecas de la API de control de Tiresias.
// build.py define TCC_NAME, TCC_DESC y TCC_FILE.
#include <winver.h>

#define TCC_VERSION 1,0,0,0
#define TCC_VERSION_STR "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TCC_VERSION
PRODUCTVERSION TCC_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "0c0a04b0"
		BEGIN
			VALUE "CompanyName", "Tiresias"
			VALUE "FileDescription", TCC_DESC
			VALUE "FileVersion", TCC_VERSION_STR
			VALUE "InternalName", TCC_NAME
			VALUE "OriginalFilename", TCC_FILE
			VALUE "ProductName", "Tiresias, lector de pantalla"
			VALUE "ProductVersion", TCC_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0c0a, 1200
	END
END
