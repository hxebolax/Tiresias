msgid "Atajos del complemento WhatsApp accesible:"
msgstr "Accessible WhatsApp add-on shortcuts:"

#: data/addons/whatsapp/appModules/whatsapp_root.py:922
msgid "Atajos propios de WhatsApp (siguen funcionando):"
msgstr "WhatsApp's own shortcuts (they still work):"

#: data/addons/whatsapp/appModules/whatsapp_root.py:923
msgid "Control+Alt+N: nuevo chat. Control+Mayúsculas+N: nuevo grupo."
msgstr "Control+Alt+N: new chat. Control+Shift+N: new group."

#: data/addons/whatsapp/appModules/whatsapp_root.py:924
msgid "Control+Alt+barra: buscar. Control+Mayúsculas+F: buscar en el chat."
msgstr "Control+Alt+slash: search. Control+Shift+F: search in the chat."

#: data/addons/whatsapp/appModules/whatsapp_root.py:925
msgid "Control+Mayúsculas+U: marcar como no leído. Control+Mayúsculas+M: silenciar. Control+Mayúsculas+A: archivar."
msgstr "Control+Shift+U: mark as unread. Control+Shift+M: mute. Control+Shift+A: archive."

#: data/addons/whatsapp/appModules/whatsapp_root.py:926
msgid "Control+Alt+Mayúsculas+P: fijar chat. Alt+I: información del chat. Alt+S: ajustes de WhatsApp."
msgstr "Control+Alt+Shift+P: pin chat. Alt+I: chat info. Alt+S: WhatsApp settings."

#: data/addons/whatsapp/appModules/whatsapp_root.py:927
msgid "Alt+R: responder. Control+Alt+D: reenviar (fuera de llamadas). Alt+8: destacar. Alt+A: adjuntar."
msgstr "Alt+R: reply. Control+Alt+D: forward (outside calls). Alt+8: star. Alt+A: attach."

#: data/addons/whatsapp/appModules/whatsapp_root.py:928
msgid "Mayúsculas+punto y Mayúsculas+coma: velocidad de la nota de voz. Alt+P: pausar la grabación."
msgstr "Shift+period and Shift+comma: voice note speed. Alt+P: pause the recording."

#: data/addons/whatsapp/appModules/whatsapp_root.py:929
msgid "Control+flecha arriba: editar el último mensaje. Escape: cerrar el chat."
msgstr "Control+up arrow: edit the last message. Escape: close the chat."

#: data/addons/whatsapp/appModules/whatsapp_root.py:930
msgid "Control+1 a Control+9: abrir el chat número N."
msgstr "Control+1 to Control+9: open chat number N."

#: data/addons/whatsapp/appModules/whatsapp_root.py:932
msgid "Ayuda de WhatsApp accesible"
msgstr "Accessible WhatsApp help"

#: data/addons/whatsapp/appModules/whatsapp_root.py:934
msgid "Ajustes del complemento de WhatsApp"
msgstr "WhatsApp add-on settings"

#: data/addons/whatsapp/globalPlugins/whatsapp_opciones.py:26
msgid "WhatsApp accesible"
msgstr "Accessible WhatsApp"

